# Game files, player data and build output never belong in this repository.
/game/
/user/
/reference/
/dist/
*.pkg
/analysis/*
!/analysis/STATUS.md
!/analysis/PLAN.md
/gow3_pc/out/
/Uncharted.lnk
__pycache__/
*.pyc

# Research output derived from the game (disassembly, extracted files): never committed.
/work/
/ps3cache/
# u2mp research tools stay local (Documents/Uncharted_Collection_MP/u2mp-tools)
/u2mp/tools/

# never commit a compiled helper or its local build folders (private; older ones held game values)
u3mp/patcher/build/*/profile-helper.bin

# launcher/native build output (tools/package_windows.sh builds it)
launcher/native/build/
launcher/native/uncharted_native.dll
launcher/native/apply_update.exe
launcher/native/pythonw_bridge.exe
